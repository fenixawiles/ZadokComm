# ZadokComm environment template.
# Copy to `.env` and adjust. Legend:
#   [REQUIRED]  the app refuses to boot in production without it
#   [OPTIONAL]  safe defaults exist for development
#   [GATE]      explicitly enables a side effect that COSTS MONEY or leaves the machine
#
# The safety model is fail-closed: with this file untouched, the shell runs
# entirely offline — mock draft engine, mock sender, no spend, nothing leaves.

# ---------------------------------------------------------------- application
# [OPTIONAL] development | production. Unknown values are treated as
# production so a typo fails safe, not open.
APP_ENV=development

# [REQUIRED in production] Flask session signing key.
SECRET_KEY=

# [REQUIRED in production] Shared secret for POST /webhooks/inbound
# (X-Zadok-Webhook-Token header). A dev default applies in development.
WEBHOOK_SHARED_SECRET=

# [OPTIONAL] Passcode for the pick-a-rep dev login (development only —
# production refuses to boot on shell auth regardless of this value).
DEV_PASSCODE=zadok-dev

# [OPTIONAL] SQLite database file.
DATABASE_PATH=./zadok.db

# ------------------------------------------------------------------- behavior
# [OPTIONAL] mock | openai. "openai" additionally requires the model-calls
# gate below AND an API key; otherwise the mock engine is used.
DRAFT_ENGINE=mock

# [OPTIONAL] Ordered client-lookup connectors.
CRM_CONNECTORS=mock_salesforce,mock_woven

# [OPTIONAL] Hours before an unanswered client message is flagged overdue.
RESPONSE_SLA_HOURS=24

# [OPTIONAL] routine_only | all. Seeds the runtime assist-scope setting on
# `flask init-db`; afterwards the live value is the `settings` table row and
# is changed from the inbox header, not here.
ZADOK_ASSIST_SCOPE_DEFAULT=routine_only

# [OPTIONAL] Cap on model output per draft.
MAX_DRAFT_OUTPUT_TOKENS=1200

# ---------------------------------------------------------------------- gates
# [GATE] Set to 1 to let a present OPENAI_API_KEY be used. COSTS MONEY when
# set. With the gate off, the key is stripped at the config chokepoint and
# nothing in the codebase can spend.
ZADOK_ALLOW_LIVE_MODEL_CALLS=0

# [GATE] Set to 1 before wiring any non-mock outbound sender. The shell ships
# only the mock sender; a real sender without this gate refuses to boot.
ZADOK_ALLOW_LIVE_SEND=0

# [OPTIONAL] OpenAI API key. Ignored entirely unless the model-calls gate is 1.
OPENAI_API_KEY=
